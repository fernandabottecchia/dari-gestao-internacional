# Configurar no servidor do TIC, nunca enviar o arquivo .env ao GitHub.
DARI_ENV=production
DARI_PUBLIC_URL=https://DOMINIO-APROVADO-PELO-TIC
DARI_SECRET_KEY=TROCAR_POR_SEGREDO_ALEATORIO_GERADO_COM_SECRETS_TOKEN_URLSAFE_64
# Usar PostgreSQL novo/dedicado, não o servidor antigo do laboratório.
# Usar URI com senha codificada (%XX quando houver caracteres reservados).
# Para banco remoto, seguir a CA/TLS institucional; preferir sslmode=verify-full.
DATABASE_URL=postgresql+psycopg://dari_app:SENHA_CODIFICADA@HOST_TIC:5432/dari?sslmode=verify-full
# Leitura automática Google desativada durante homologação.
# Ativar (=0) somente após configurar/autorizar credenciais de leitura.
DARI_FORMS_AUTOSYNC_DISABLED=1
DARI_GOOGLE_CREDENTIALS_DIR=/run/secrets/dari-google
# Somente os IPs do proxy reverso administrado pelo TIC. Nunca '*' na internet.
DARI_FORWARDED_ALLOW_IPS=127.0.0.1
TZ=America/Sao_Paulo
